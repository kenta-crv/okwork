meta charset="UTF-8"
meta name="viewport" content="width=device-width, initial-scale=1.0"

= csrf_meta_tags
= csp_meta_tag

- daily_cleaning_lp = controller_name == "pages" && action_name == "daily_cleaning"
- isolated_lp = daily_cleaning_lp
- lp_stylesheet = daily_cleaning_lp ? "daily_cleaning" : "application"
- unless isolated_lp
  link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet"
= stylesheet_link_tag lp_stylesheet, media: "all", "data-turbolinks-track": "reload"
= display_meta_tags
= favicon_link_tag "ok-work-cleaning-icon.png"
link rel="apple-touch-icon" href=image_path("ok-work-cleaning-icon.png")

- if defined?(breadcrumbs) && breadcrumbs.present?
  script type="application/ld+json"
    = raw(breadcrumb_list_json_ld)

- if controller_name == "pages" && action_name == "index"
  script type="application/ld+json"
    = raw(organization_json_ld)
  script type="application/ld+json"
    = raw(website_json_ld)
  - faq_ld = faq_page_json_ld(lp_faqs)
  - if faq_ld.present?
    script type="application/ld+json"
      = raw(faq_ld)


    header.custom-navbar
      .container-fluid.d-flex.align-items-center.justify-content-between.h-100
        .d-flex.align-items-center.logo-section
          - if request.host.include?("ri-plus.jp")
            = image_tag "logo-riplus.png", class: "nav-logo me-2", alt: "RI-PLUS"
          - elsif request.host.include?("自販機.net")
            = image_tag "logo-vender.png", class: "nav-logo me-2", alt: "自販機"
          - elsif request.path.start_with?('/pages/app')
            = image_tag "logo-okurite.png", class: "nav-logo me-2", alt: "自販機"
          - else
            = image_tag "ok-work-cleaning-logo.png", class: "nav-logo me-2", alt: "OK Work CLEANING SERVICE"
          span.nav-subtext
            | 
        nav.nav-menu.d-none.d-lg-flex
          ul.d-flex.list-unstyled.mb-0
            li
                = link_to "トップページ", "/" , class: "nav-link-custom"   
            li
              = link_to "人材サービス", staffing_path, class: "nav-link-custom", data: { turbolinks: false }
            li
              = link_to "事業内容", staffing_path(anchor: "business"), class: "nav-link-custom", data: { turbolinks: false }
            li
              = link_to "導入事例", staffing_path(anchor: "case"), class: "nav-link-custom", data: { turbolinks: false }
            li
              = link_to "お役立ち記事", "/columns", class: "nav-link-custom"
        nav.mobile-nav.d-lg-none
          #mobile-nav-toggle.mobile-nav-toggle
            span.hamburger-line
            span.hamburger-line
            span.hamburger-line
          #mobile-nav-menu.mobile-nav-menu
            .mobile-nav-header
              #mobile-nav-close.mobile-nav-close
                span.close-line
                span.close-line
            ul.mobile-nav-list
              li
                = link_to "トップページ", "/" , class: "nav-link-custom"        
              li
                = link_to "人材サービス", staffing_path, class: "nav-link-custom", data: { turbolinks: false }
              li
                = link_to "事業内容", staffing_path(anchor: "business"), class: "nav-link-custom", data: { turbolinks: false }
              li
                = link_to "導入事例", staffing_path(anchor: "case"), class: "nav-link-custom", data: { turbolinks: false }
              li
                = link_to "お役立ち記事", "/columns", class: "nav-link-custom"
            .mobile-nav-actions
              = image_tag "search.png", class: "search-icon", alt: "Search"
              button.btn.login-btn
                | ログイン
              button.btn.contact-btn.d-flex.align-items-center.gap-2
                = link_to "お問い合わせ", staffing_path(anchor: "inquiry"), class: "nav-link-custom", data: { turbolinks: false }
                = image_tag "arrow-down.png", class: "arrow-icon", alt: "Arrow"
        .d-flex.align-items-center.gap-3.d-none.d-lg-flex
          = image_tag "search.png", class: "search-icon", alt: "Search"
          button.btn.login-btn
            | ログイン
          button.btn.contact-btn.d-flex.align-items-center.gap-2
            = link_to "お問い合わせ", staffing_path(anchor: "inquiry"), class: "nav-link-custom", data: { turbolinks: false }
            = image_tag "arrow-down.png", class: "arrow-icon", alt: "Arrow"


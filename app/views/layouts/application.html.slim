- top_home = controller_name == "pages" && action_name == "index"
- daily_cleaning_lp = controller_name == "pages" && action_name == "daily_cleaning"
doctype html
html lang="ja" class=(top_home ? "jw-top-page" : daily_cleaning_lp ? "dclp-page" : nil)
  head
    = render "layouts/head"

    / --- canonical（各ドメイン用） ---
    - canonical_url = request.url
    link rel="canonical" href=canonical_url

  body
    - unless top_home || daily_cleaning_lp
      = render "layouts/header"

    - unless top_home || daily_cleaning_lp
      - if breadcrumbs.any?
        = render "shared/breadcrumbs"

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        | 送信完了しました

      script
        |
          gtag('event', 'conversion', {
              'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
              'value': 1.0,
              'currency': 'JPY'
          });

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    main class=(top_home ? "jw-top-main" : daily_cleaning_lp ? "dclp-main" : nil)
      = yield

    - unless top_home || daily_cleaning_lp
      footer.site-footer
        .site-footer__inner
          nav.site-footer__nav aria-label="フッターナビ"
            = link_to "トップ", "/"
            = link_to "人材サービス", "/staffing"
            = link_to "日常清掃", "/daily"
            = link_to "お役立ち記事", "/columns"
            = link_to "お問い合わせ", "/staffing#inquiry"
          p.site-footer__copy © #{Time.current.year} OK Work

    = javascript_include_tag "application", "data-turbolinks-track": "reload"

doctype html
html lang="ja"
  head
    = render "layouts/head"

    / --- canonical（各ドメイン用） ---
    - canonical_url = request.url
    link rel="canonical" href=canonical_url

  body
    = render "layouts/header"

    - if breadcrumbs.any?
      = render "shared/breadcrumbs"

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        | 送信完了しました

      script
        |
          gtag('event', 'conversion', {
              'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
              'value': 1.0,
              'currency': 'JPY'
          });

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    = yield

    footer.site-footer
      .site-footer__inner
        nav.site-footer__nav aria-label="フッターナビ"
          = link_to "トップ", "/"
          = link_to "日常清掃", "/daily"
          = link_to "お役立ち記事", "/columns"
          a href="#inquiry" お問い合わせ
        p.site-footer__copy © #{Time.current.year} OK Work

    = javascript_include_tag "application", "data-turbolinks-track": "reload"
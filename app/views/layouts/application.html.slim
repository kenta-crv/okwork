- top_home = controller_name == "pages" && action_name == "index"
- daily_cleaning_lp = controller_name == "pages" && action_name == "daily_cleaning"
- isolated_lp = daily_cleaning_lp
- isolated_lp_html_class = daily_cleaning_lp ? "dclp-page" : nil
- isolated_lp_main_class = daily_cleaning_lp ? "dclp-main" : nil
doctype html
html lang="ja" class=(top_home ? "jw-top-page" : isolated_lp_html_class)
  head
    = render "layouts/head"

    / --- canonical（各ドメイン用） ---
    - canonical_url = request.url
    link rel="canonical" href=canonical_url

  body
    - unless top_home || isolated_lp
      = render "layouts/header"

    - unless top_home || isolated_lp
      - if breadcrumbs.any?
        = render "shared/breadcrumbs"

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        | 送信完了しました

      = yahoo_ads_conversion_tags
      script
        |
          gtag('event', 'conversion', {
              'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
              'value': 1.0,
              'currency': 'JPY'
          });
          (function () {
            var flash = document.querySelector('.flash-message');
            if (!flash) return;
            setTimeout(function () {
              flash.style.transition = 'opacity 0.5s ease';
              flash.style.opacity = '0';
              setTimeout(function () { flash.remove(); }, 500);
            }, 3000);
          })();

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    main class=(top_home ? "jw-top-main" : isolated_lp_main_class)
      = yield

    - unless top_home || isolated_lp
      footer.site-footer
        .site-footer__inner
          nav.site-footer__nav aria-label="フッターナビ"
            = link_to "トップ", "/"
            = link_to "人材サービス", "/staffing"
            = link_to "日常清掃", "/daily"
            = link_to "お役立ち記事", "/columns"
            = link_to "お問い合わせ", "/staffing#inquiry"
          p.site-footer__copy © #{Time.current.year} OK Work

    = javascript_include_tag "application", "data-turbolinks-track": "reload"

- set_meta_tags title: "法人向け清掃なら『OK Work』｜日常清掃・ビル清掃"
- set_meta_tags description: "日常清掃からビル・店舗・マンション巡回まで。現場に合わせた法人向け清掃プランをご提案します。"

- consultation_url = "/daily-cleaning#contact"
- cleaning_services = [{ name: "マンション巡回清掃", image: "apartment.jpg", url: "/mansion" }, { name: "病院清掃", image: "hospital.jpg", url: "/hospital" }, { name: "ホテル清掃", image: "hotel.jpg", url: "/hotel" }, { name: "オフィス清掃", image: "office.jpg", url: "/office" }, { name: "介護清掃", image: "care.jpg", url: "/care" }, { name: "ビルクリーニング", image: "building.jpg", url: "/building" }]

section.okw-home aria-label="OK Work 法人向け清掃サービス"
  .okw-home__stage
    = image_tag "ok_work/background.jpg",
      class: "okw-home__background",
      alt: "",
      aria: { hidden: true },
      loading: "eager"

    = image_tag "mark.png",
      class: "okw-home__mark",
      alt: "",
      aria: { hidden: true },
      loading: "eager"

    .okw-home__copy
      p.okw-home__eyebrow
        span 法人向け清掃サービス
        span.okw-home__eyebrow-line aria-hidden="true"

      h1.okw-home__title
        span 法人の清掃、
        span まとめてお任せ。

      p.okw-home__description
        span 日常清掃から定期清掃まで。
        span 現場に合わせた清掃プランをご提案します。

      = link_to consultation_url, class: "okw-home__consultation" do
        span 清掃について相談する
        svg.okw-home__consultation-arrow viewBox="0 0 32 24" fill="none" aria-hidden="true"
          path d="M2 12H28M19 3L28 12L19 21" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"

    nav.okw-home__services aria-label="清掃サービスを選ぶ"
      - cleaning_services.each do |service|
        = link_to service[:url], class: "okw-home__service" do
          .okw-home__service-face
            = image_tag "ok_work/#{service[:image]}",
              class: "okw-home__service-photo",
              alt: "",
              loading: "eager"

            span.okw-home__service-shade aria-hidden="true"

          span.okw-home__service-name = service[:name]

          span.okw-home__service-arrow aria-hidden="true"
            svg viewBox="0 0 24 24" fill="none"
              path d="M4 12H20M13 5L20 12L13 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"

    = image_tag "team.png",
      class: "okw-home__team",
      alt: "清掃機器・モップ・脚立を備えたOK Workの清掃スタッフ",
      loading: "eager"

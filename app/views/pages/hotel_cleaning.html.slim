  javascript:
    (function () {
      var items = document.querySelectorAll('.clean-partner-lp .cp-faq__item');
      items.forEach(function (item) {
        item.addEventListener('toggle', function () {
          if (!item.open) return;
          items.forEach(function (other) {
            if (other !== item) other.open = false;
          });
        });
      });
    })();

    (function () {
      var grid = document.querySelector('.clean-partner-lp .cp-reviews__grid');
      if (!grid || grid.querySelector('.cp-reviews__track')) return;
      var set = document.createElement('div');
      set.className = 'cp-reviews__set';
      while (grid.firstChild) set.appendChild(grid.firstChild);
      var track = document.createElement('div');
      track.className = 'cp-reviews__track';
      var clone = set.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(set);
      track.appendChild(clone);
      grid.appendChild(track);
    })();

    (function () {
      var header = document.querySelector('.clean-partner-lp .cp-header');
      if (!header) return;
      var ticking = false;
      function shouldShow() {
        return window.scrollY > 80;
      }
      function update() {
        header.classList.toggle('is-visible', shouldShow());
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          update();
        });
      }
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      header.addEventListener('click', function (e) {
        var a = e.target.closest('a[href^="#"]');
        if (!a) return;
        var id = (a.getAttribute('href') || '').slice(1);
        if (!id) return;
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        if (history.replaceState) history.replaceState(null, '', '#' + id);
        if (id === 'top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    })();

    (function () {
      var modal = document.getElementById('contact-modal');
      if (!modal) return;
      function openModal(e) {
        if (e) e.preventDefault();
        try {
          if (typeof modal.showModal === 'function') {
            if (!modal.open) modal.showModal();
          } else {
            modal.setAttribute('open', '');
          }
        } catch (err) {
          modal.setAttribute('open', '');
        }
      }
      function closeModal() {
        try {
          if (typeof modal.close === 'function' && modal.open) modal.close();
          else modal.removeAttribute('open');
        } catch (err) {
          modal.removeAttribute('open');
        }
      }
      document.querySelectorAll('[data-open-contact]').forEach(function (el) {
        el.addEventListener('click', openModal);
      });
      var closeBtn = modal.querySelector('[data-close-contact]');
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
      if (#{(params[:error].to_s == '1' || params[:sent].to_s == '1').to_json}) openModal();
      if (#{(params[:sent].to_s == '1' && params[:via].to_s == 'line').to_json}) {
        setTimeout(function () {
          window.location.href = 'https://lin.ee/XJMSNq9';
        }, 2500);
      }
      var contactForm = document.getElementById('hotel-cleaning-contact');
      var mailBtn = document.getElementById('cp-form-mail');
      var lineBtn = document.getElementById('cp-form-line');
      var submitHint = document.getElementById('cp-form-submit-hint');
      function setSubmitEnabled(on) {
        [mailBtn, lineBtn].forEach(function (btn) {
          if (!btn) return;
          btn.disabled = !on;
          btn.setAttribute('aria-disabled', on ? 'false' : 'true');
          btn.classList.toggle('is-disabled', !on);
        });
        if (submitHint) submitHint.hidden = !!on;
      }
      function updateSubmitState() {
        if (!contactForm) return;
        var names = ['contract[company]', 'contract[name]', 'contract[tel]', 'contract[email]', 'contract[address]', 'contract[url]'];
        var ready = names.every(function (name) {
          var el = contactForm.elements[name];
          return el && String(el.value || '').trim();
        });
        var company = contactForm.elements['contract[company]'];
        var hasCorporate = company && /株式会社|合同会社|有限会社|合資会社|合名会社|一般社団法人|一般財団法人|NPO法人|医療法人|社会福祉法人|学校法人|宗教法人|特定非営利活動法人/.test(String(company.value || ''));
        if (submitHint) {
          submitHint.textContent = (ready && !hasCorporate) ? '会社名に「株式会社」などを含めてください。' : '必須項目を入力すると送信できます。';
        }
        setSubmitEnabled(ready && hasCorporate);
      }
      if (contactForm) {
        contactForm.addEventListener('input', updateSubmitState);
        contactForm.addEventListener('change', updateSubmitState);
      }
      updateSubmitState();
    })();


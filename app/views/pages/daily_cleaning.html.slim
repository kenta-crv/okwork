  header.cp-header
    .cp-container.cp-header__inner
      = link_to '#top', class: 'cp-brand', aria: { label: 'Clean Partner トップへ' } do
        span.cp-brand__mark aria-hidden="true"
          svg.cp-ico.cp-ico--solid.cp-brand__spark.cp-brand__spark--large
            use href="#cp-i-spark"
          svg.cp-ico.cp-ico--solid.cp-brand__spark.cp-brand__spark--small
            use href="#cp-i-spark"
        span.cp-brand__copy
          strong.cp-brand__name Clean Partner
          small.cp-brand__ja クリーンパートナー

      nav.cp-nav aria-label="メインナビゲーション"
        = link_to 'お悩み', '#service', class: 'cp-nav__link'
        = link_to '選ばれる理由', '#features', class: 'cp-nav__link'
        = link_to '料金の目安', '#price', class: 'cp-nav__link'
        = link_to 'ご利用の流れ', '#flow', class: 'cp-nav__link'
        = link_to 'よくあるご質問', '#faq', class: 'cp-nav__link'

      = link_to '#contact', class: 'cp-contact-button cp-contact-button--header' do
        span.cp-contact-button__icon aria-hidden="true"
          svg.cp-ico
            use href="#cp-i-mail"
        span.cp-contact-button__copy
          strong 無料で相談する
          small お問い合わせはこちら

  main
    section#top.cp-hero
      .cp-hero__image aria-hidden="true"
      .cp-container.cp-hero__inner
        .cp-hero__content
          p.cp-hero__eyebrow 現場の人材力で、キレイを支える。
          h1.cp-hero__title
            | 日常清掃の人材不足なら
            br
            | OK清掃に
            em お任せ！
          p.cp-hero__lead
            | オフィス・店舗・施設に必要な清掃スタッフを、
            br
            | 全国・必要なタイミングで手配します。

          ul.cp-hero__points
            li.cp-round-point
              span.cp-line-icon aria-hidden="true"
                svg.cp-ico
                  use href="#cp-i-building"
              strong 登録者4,000名
              b 経験者多数
            li.cp-round-point
              span.cp-line-icon aria-hidden="true"
                svg.cp-ico
                  use href="#cp-i-calendar"
              strong 全国の現場に
              b 対応
            li.cp-round-point
              span.cp-line-icon aria-hidden="true"
                svg.cp-ico
                  use href="#cp-i-heart-person"
              strong 深夜・早朝も
              b 柔軟に手配

    section#service.cp-concerns.cp-section
      .cp-container
        h2.cp-section-title
          | こんな
          em お悩み
          | はありませんか？

        .cp-concerns__grid
          article.cp-concern-card
            span.cp-concern-card__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-worry"
            p
              | 清掃スタッフが足りず、
              br
              | 現場が回らない
          article.cp-concern-card
            span.cp-concern-card__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-crossed"
            p
              | 採用しても定着せず、
              br
              | 人員が安定しない
          article.cp-concern-card
            span.cp-concern-card__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-building"
            p
              | 急な欠員や増員に
              br
              | すぐ対応できない
          article.cp-concern-card
            span.cp-concern-card__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-calc"
            p
              | コストを抑えつつ
              br
              | 経験者を確保したい

        p.cp-concerns__answer
          | そのお悩み、
          em 清掃人材の手配
          | が解決します！
        span.cp-concerns__arrow aria-hidden="true"

    section#features.cp-features.cp-section
      .cp-container
        p.cp-section-kicker 人材力で、現場を支える。
        h2.cp-heading
          | クリーンパートナーが
          br
          em 選ばれる
          | 理由
        p.cp-heading-lead
          | 毎月アクティブ約4,000名・新規登録約500名の人材力で、
          br
          | 全国の現場へ、経験者を手配します。

        .cp-features__grid
          article.cp-feature-card
            .cp-feature-card__body
              .cp-feature-card__meta
                span.cp-feature-card__icon aria-hidden="true"
                  svg.cp-ico
                    use href="#cp-i-sparkle"
                span.cp-feature-card__number 01
              h3 圧倒的な人材規模
              p 毎月アクティブ登録者約4,000名・新規登録約500名。幅広い清掃現場に対応できる人材プールから、安定してスタッフを手配します。
            = image_tag 'feature-quality.jpg', class: 'cp-feature-card__image', alt: 'クロスで机を清掃するスタッフ'
          article.cp-feature-card
            .cp-feature-card__body
              .cp-feature-card__meta
                span.cp-feature-card__icon aria-hidden="true"
                  svg.cp-ico
                    use href="#cp-i-team"
                span.cp-feature-card__number 02
              h3 スピード手配
              p 必要なタイミングに、経験者を迅速に手配します。急な欠員補充や増員にも対応できます。
            = image_tag 'feature-team.jpg', class: 'cp-feature-card__image', alt: '清掃スタッフチーム'
          article.cp-feature-card
            .cp-feature-card__body
              .cp-feature-card__meta
                span.cp-feature-card__icon aria-hidden="true"
                  svg.cp-ico
                    use href="#cp-i-shield"
                span.cp-feature-card__number 03
              h3 全国対応・深夜にも強い
              p 全国の現場に対応。早朝・深夜の清掃も、速やかに人材を手配できます。
            = image_tag 'feature-control.jpg', class: 'cp-feature-card__image', alt: '品質チェックシート'

        p.cp-features__note
          | 当社の役割は人材の手配・提供です。現場での作業指示・管理はお客様にお願いしています。

    section#price.cp-price.cp-section
      .cp-container
        p.cp-section-kicker わかりやすく、安心の料金プラン
        h2.cp-heading
          em 料金
          | のご案内
        p.cp-heading-lead ご予算や稼働頻度に合わせて、最適な人員手配プランをお選びいただけます。

        h3.cp-subheading 選べる3つの料金プラン
        .cp-price__grid
          article.cp-price-card
            header.cp-price-card__header
              h4 ライトプラン
              p まずは少人数から人材を手配したい方へ
            .cp-price-card__body
              span.cp-price-card__frequency 月2回
              p.cp-price-card__amount
                strong 22,000
                span 円〜／月
              small （税込 24,200円〜）
              ul.cp-price-card__specs
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-clock"
                  b 作業時間
                  span 1回あたり 約2時間
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-person"
                  b 作業スタッフ
                  span 1名体制
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-building"
                  b おすすめの場所
                  span 小規模オフィス・店舗など
              = link_to 'プラン内容を詳しく見る', '#contact', class: 'cp-outline-button'

          article.cp-price-card.cp-price-card--featured
            span.cp-price-card__badge 人気No.1
            header.cp-price-card__header
              h4 スタンダードプラン
              p 定期的に清掃人材を確保したい方へ
            .cp-price-card__body
              span.cp-price-card__frequency 月4回
              p.cp-price-card__amount
                strong 38,000
                span 円〜／月
              small （税込 41,800円〜）
              ul.cp-price-card__specs
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-clock"
                  b 作業時間
                  span 1回あたり 約2.5〜3時間
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-people"
                  b 作業スタッフ
                  span 1〜2名体制
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-building"
                  b おすすめの場所
                  span オフィス・店舗・施設など
              = link_to 'プラン内容を詳しく見る', '#contact', class: 'cp-outline-button cp-outline-button--filled'

          article.cp-price-card
            header.cp-price-card__header
              h4 プレミアムプラン
              p 毎日の清掃人員を安定させたい方へ
            .cp-price-card__body
              span.cp-price-card__frequency 毎日清掃
              p.cp-price-card__amount
                strong 68,000
                span 円〜／月
              small （税込 74,800円〜）
              ul.cp-price-card__specs
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-clock"
                  b 作業時間
                  span 1回あたり 約2〜3時間
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-people"
                  b 作業スタッフ
                  span 2名体制
                li
                  span.cp-spec-ico aria-hidden="true"
                    svg.cp-ico
                      use href="#cp-i-building"
                  b おすすめの場所
                  span 大規模オフィス・商業施設など
              = link_to 'プラン内容を詳しく見る', '#contact', class: 'cp-outline-button'

        p.cp-price__note
          | ※上記は一例です。建物の広さ・稼働人数・勤務時間により料金は変動いたします。まずはお気軽にご相談ください。
          br
          | ※清掃用具はお客様にてご用意ください。

        /h3.cp-subheading オプションサービス
        /.cp-options
          .cp-option
            span.cp-option__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-ac"
            p
              b エアコン清掃
              strong 6,000円〜
              small ／台（税込 6,600円〜）
          .cp-option
            span.cp-option__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-wax"
            p
              b 床ワックスがけ
              strong 300円〜
              small ／㎡（税込 330円〜）
          .cp-option
            span.cp-option__icon aria-hidden="true"
              svg.cp-ico
                use href="#cp-i-window"
            p
              b ガラス清掃
              strong 200円〜
              small ／㎡（税込 220円〜）
          .cp-option
